# =============================================================================
# olist-data-ai-platform
# Local environment configuration template
# Copy to .env. Never commit the real .env.
# =============================================================================

# Project
COMPOSE_PROJECT_NAME=olist-data-ai-platform
APP_ENV=local
TZ=UTC
LOG_LEVEL=INFO

# PostgreSQL server
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=olist_admin
POSTGRES_ADMIN_PASSWORD=change_me_postgres_admin

# Analytical warehouse
OLIST_WAREHOUSE_DB=olist_warehouse

# Future warehouse roles
DBT_USER=dbt_runner
DBT_PASSWORD=change_me_dbt
SUPERSET_READER_USER=superset_reader
SUPERSET_READER_PASSWORD=change_me_superset_reader
API_READER_USER=api_reader
API_READER_PASSWORD=change_me_api_reader
AGENT_READER_USER=agent_reader
AGENT_READER_PASSWORD=change_me_agent_reader
ML_RUNNER_USER=ml_runner
ML_RUNNER_PASSWORD=change_me_ml_runner

# S3-compatible object storage exposed by Garage
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_BUCKET_RAW=olist-raw
S3_BUCKET_BRONZE=olist-bronze
S3_BUCKET_SILVER=olist-silver
S3_BUCKET_GOLD=olist-gold
S3_BUCKET_ML=olist-ml

# Foundation pipeline credentials
S3_PIPELINE_ACCESS_KEY=generate_me
S3_PIPELINE_SECRET_KEY=generate_me

# Future MLflow S3 credentials (not provisioned in M0)
S3_MLFLOW_ACCESS_KEY=generate_me
S3_MLFLOW_SECRET_KEY=generate_me

# Garage
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_ADMIN_PORT=3903
GARAGE_RPC_SECRET=generate_me
GARAGE_ADMIN_TOKEN=generate_me
GARAGE_METRICS_TOKEN=generate_me

# Future Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db
AIRFLOW_WEB_PORT=8080
AIRFLOW_FERNET_KEY=generate_me
AIRFLOW_SECRET_KEY=generate_me

# Future Superset metadata database
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change_me_superset_db
SUPERSET_PORT=8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin
SUPERSET_ADMIN_FIRSTNAME=Olist
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.invalid
SUPERSET_SECRET_KEY=generate_me

# Future MLflow
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change_me_mlflow_db
MLFLOW_PORT=5000
MLFLOW_ARTIFACT_ROOT=s3://olist-ml/
MLFLOW_S3_ENDPOINT_URL=http://garage:3900

# Future FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Future Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Agent fail-safe
ENABLE_AGENT_ACTIONS=false
